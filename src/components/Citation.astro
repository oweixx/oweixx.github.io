---
interface Props { id: string; bibtex: string }
const { id, bibtex } = Astro.props;
---
<details class="citation" id={`citation-${id}`}>
  <summary>BIBTEX</summary>
  <div class="citation-panel">
    <button type="button" class="copy-citation">Copy citation</button>
    <span class="citation-status" role="status" aria-live="polite"></span>
    <pre tabindex="0"><code>{bibtex}</code></pre>
  </div>
</details>
<script>
  for (const citation of document.querySelectorAll<HTMLElement>('.citation')) {
    const button = citation.querySelector<HTMLButtonElement>('.copy-citation')!;
    const status = citation.querySelector<HTMLElement>('.citation-status')!;
    const code = citation.querySelector('code')!;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        status.textContent = 'Copied';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
        status.textContent = 'Select and copy with Ctrl/Cmd + C';
      }
    });
  }
</script>
<style>
  .citation { display: contents; }
  summary { display: inline-flex; align-items: center; justify-content: center; padding: 4px 16px; border: 1px solid var(--blue-border); border-radius: 4px; background: #fff; color: var(--blue-deep); font-size: 12px; font-weight: 400; line-height: 1.5; cursor: pointer; list-style: none; transition: color .18s ease, background-color .18s ease, border-color .18s ease; }
  summary::-webkit-details-marker { display: none; }
  summary:hover, summary:focus-visible, .citation[open] summary { color: #fff; background: var(--blue); border-color: var(--blue); }
  .citation-panel { flex-basis: 100%; min-width: 0; padding: 12px; background: var(--blue-soft); border: 1px solid var(--blue-border); border-radius: 4px; }
  pre { margin: 10px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 11px; line-height: 1.5; }
  .copy-citation { padding: 4px 8px; background: #fff; border: 1px solid var(--blue-border); border-radius: 4px; color: var(--blue-deep); font-size: 12px; }
  .copy-citation:hover { border-color: var(--blue); background: var(--blue-soft); }
  .citation-status { margin-left: 8px; color: #555; font-size: 12px; }
  @media (prefers-reduced-motion: reduce) { summary { transition: none; } }
</style>
