---
import { analyticsSite } from '../config/analytics';
interface Props { path: string; period?: 'today'; label?: string }
const { path, period, label = '누적 방문' } = Astro.props;
---
<span class="view-count" data-counter-path={path} data-counter-period={period} data-counter-site={analyticsSite} title="같은 세션에서 같은 페이지의 반복 방문은 한 번으로 집계됩니다. 최대 4시간 지연될 수 있습니다.">{label} <span data-counter-value>—</span></span>
<style>
  [data-counter-value] { color: #666; font-variant-numeric: tabular-nums; }
</style>
