---
interface Props { path: string; period?: 'today'; label?: string }
const { path, period, label = 'Visits' } = Astro.props;
---
<span class="view-count" data-counter-path={path} data-counter-period={period} title="Page visits · Each page load counts once">{label} <span data-counter-value>—</span></span>
<style>
  [data-counter-value] { color: #666; font-variant-numeric: tabular-nums; }
</style>
