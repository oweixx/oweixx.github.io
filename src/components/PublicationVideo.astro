---
interface Props { name: string; label: string; width: number; height: number }
const { name, label, width, height } = Astro.props;
const poster = `/assets/${name}-poster.webp`;
---
<video data-publication-video autoplay loop muted playsinline preload="none" poster={poster} width={width} height={height} aria-label={label}>
  <source data-src={`/assets/${name}.webm`} type="video/webm" />
  <source data-src={`/assets/${name}.mp4`} type="video/mp4" />
  <img src={poster} alt={label} width={width} height={height} loading="lazy" />
</video>
<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-publication-video]')];
  const visible = new Set<HTMLVideoElement>();
  const loaded = new WeakSet<HTMLVideoElement>();
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const shouldPlay = (video: HTMLVideoElement) => visible.has(video) && !document.hidden && !reducedMotion.matches;

  function update(video: HTMLVideoElement) {
    if (!shouldPlay(video)) { video.pause(); return; }
    if (!loaded.has(video)) {
      for (const source of video.querySelectorAll('source')) source.src = source.dataset.src!;
      video.muted = true;
      video.load();
      loaded.add(video);
    }
    // Keep the poster if the browser blocks autoplay or cannot load the video.
    void video.play().then(() => { if (!shouldPlay(video)) video.pause(); }).catch(() => {});
  }

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) visible.add(video);
        else visible.delete(video);
        update(video);
      }
    });
    for (const video of videos) observer.observe(video);
  } else {
    for (const video of videos) { visible.add(video); update(video); }
  }
  const updateAll = () => videos.forEach(update);
  document.addEventListener('visibilitychange', updateAll);
  reducedMotion.addEventListener('change', updateAll);
</script>
