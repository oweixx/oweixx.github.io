---
import "../styles/blog.css";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import Analytics from "../components/Analytics.astro";
import ViewCount from "../components/ViewCount.astro";
import SiteFonts from "../components/SiteFonts.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
const posts = await getPosts();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MinHyeok Bang</title>
  <meta name="description" content="MinHyeok Bang — BS student at Jeonbuk National University, researching 3D vision and generative modeling." />
  <link rel="canonical" href="https://oweixx.github.io/" />
  <SiteFonts />
  <style is:global>
    body { font-size: 16px; color: #1a1a1a; }
    a { color: #2779c4; }
    .wrap { min-height: 100vh; padding: 48px 48px 72px; }
    .container { max-width: 1240px; margin: 0 auto; }
    .name { margin: 0 0 32px; font-size: 1.65em; line-height: 1; font-weight: 300; }
    .name strong { font-weight: 700; }
    .profile { display: flex; align-items: center; gap: 40px; }
    .photo { width: 184px; height: 184px; flex: 0 0 184px; }
    .photo img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
    .profile-info { min-width: 0; }
    .position { margin: 0 0 6px; font-size: 16px; font-weight: 700; line-height: 1.3; }
    .department { margin: 0 0 18px; font-size: 16px; line-height: 1.3; }
    .site-visits { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; font-size: 12px; color: #737373; }
    .section { margin-top: 44px; }
    .section-title { margin: 0 0 16px; padding-bottom: 7px; border-bottom: 1px solid #ccc; font-size: 1.25em; font-weight: 400; line-height: 1.3; }
    .about p { margin: 0 0 .5em; font-size: 16px; line-height: 1.6; }
    .about p:last-child { margin-bottom: 0; }
    .contribution-note { margin: 0 0 26px; font-size: 16px; line-height: 1.3; }
    .pubs { display: grid; gap: 36px; }
    .pub { display: grid; grid-template-columns: minmax(0, 44%) minmax(0, 1fr); gap: 32px; align-items: start; }
    .pub-media { display: block; position: relative; overflow: hidden; box-shadow: 0 2px 9px rgb(0 0 0 / 15%); }
    .pub-media img { width: 100%; height: auto; display: block; }
    .pub-media.edgar img { max-height: 320px; object-fit: contain; background: #f8faf8; }
    .pub-badge { position: absolute; top: 8px; left: 8px; padding: 6px 13.5px; border-radius: 4.5px; background: #2779c4; color: #fff; font-size: 18px; font-weight: 400; line-height: 1.3; }
    .pub-title { margin: 0 0 6px; font-size: 15px; line-height: 1.3; font-weight: 400; }
    .pub-title a { color: inherit; }
    .pub-title a:hover { color: #2779c4; }
    .pub-authors { margin: 0 0 6px; font-size: 15px; line-height: 1.3; }
    .pub-authors a, .pub-authors a:hover, .pub-authors a:focus-visible { color: #000; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
    .pub-authors .me { font-weight: 700; }
    .pub-venue { margin: 0 0 6px; font-size: 15px; line-height: 1.3; }
    .pub-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .pub-links a { display: inline-flex; align-items: center; justify-content: center; padding: 4px 16px; border: 1px solid currentColor; border-radius: 2px; color: #262626; font-size: 12px; font-weight: 400; line-height: 1.5; }
    .pub-links a:hover, .pub-links a:focus-visible { color: #fff; background: #2779c4; border-color: #2779c4; text-decoration: none; }
    .news { display: grid; gap: 12px; }
    .news-row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 20px; font-size: 16px; line-height: 1.6; }
    .news-date { font-weight: 700; }
    .recent-posts .post-list > li:first-child { border-top: 0; }
    .recent-posts .post-list > li { padding: 14px 0 20px; }
    .recent-posts .post-list h2 { font-size: 16px; font-weight: 400; }
    .all-posts { margin: 16px 0 0; font-size: 16px; }
    .footer { margin-top: 60px; padding-top: 22px; border-top: 1px solid #ddd; color: #737373; font-size: 14px; }
    @media (max-width: 760px) {
      .wrap { padding: 32px 22px 48px; }
      .name { margin-bottom: 24px; }
      .profile { gap: 22px; }
      .photo { width: 128px; height: 128px; flex-basis: 128px; }
      .department { margin-bottom: 12px; }
      .section { margin-top: 36px; }
      .pub { grid-template-columns: minmax(0, 1fr); gap: 22px; }
      .news-row { grid-template-columns: 90px minmax(0, 1fr); gap: 14px; }
    }
    @media (max-width: 420px) {
      .profile { flex-direction: column; align-items: flex-start; gap: 20px; }
      .photo { width: 144px; height: 144px; flex-basis: auto; }
      .news-row { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap">
    <div class="container">
      <header>
        <h1 class="name"><strong>MinHyeok</strong> Bang</h1>
        <div class="profile">
          <div class="photo"><img src="/assets/profile.png" alt="MinHyeok Bang" width="184" height="184" /></div>
          <div class="profile-info">
            <p class="position">B.S Student @ JBNU</p>
            <p class="department">Computer Science · Jeonbuk National University</p>
            <ProfileLinks />
            <div class="site-visits" aria-label="Site visits">
              <ViewCount path="TOTAL" period="today" label="Today" />
              <ViewCount path="TOTAL" label="Total" />
            </div>
          </div>
        </div>
      </header>

      <main id="main">
        <section class="section about" aria-labelledby="about-title">
          <h2 id="about-title" class="section-title">About Me</h2>
          <p>I am an undergraduate student at Jeonbuk National University, majoring in Computer Science.</p>
          <p>My research interests lie in 3D vision and generative modeling, including Gaussian Splatting, avatars, and style transfer.</p>
          <p>I work with <a href="https://jbnu-vilab.github.io/people/">Prof. Se-Ho Lee</a> at the <a href="https://jbnu-vilab.github.io/">Vision Intelligence Lab</a> @ JBNU and <a href="https://vml.kaist.ac.kr/main/people/person/1">Prof. Junyong Noh</a> at the <a href="https://vml.kaist.ac.kr/">Visual Media Lab</a> @ KAIST.</p>
          <p>I write about my research and learning experiences on my <a href="/blog/">blog</a>.</p>
        </section>

        <section class="section" aria-labelledby="news-title">
          <h2 id="news-title" class="section-title">News</h2>
          <div class="news">
            <div class="news-row">
              <div class="news-date">Nov, 2026</div>
              <div><a href="https://kwanyun.github.io/edgar/#top">EDGAR</a> has been accepted to <strong>ACM Transactions on Graphics (TOG)</strong>.</div>
            </div>
            <div class="news-row">
              <div class="news-date">Jun, 2026</div>
              <div><a href="https://kjun627.github.io/gast-web/">Geometry-Aware Style Transfer</a> has been accepted to <strong>ECCV 2026</strong>.</div>
            </div>
            <div class="news-row">
              <div class="news-date">Dec, 2025</div>
              <div>Joined the <a href="https://vml.kaist.ac.kr/">Visual Media Lab</a> @ KAIST as an undergraduate researcher.</div>
            </div>
            <div class="news-row">
              <div class="news-date">Apr, 2025</div>
              <div>Joined the <a href="https://jbnu-vilab.github.io/">Vision Intelligence Lab</a> @ JBNU as an undergraduate researcher.</div>
            </div>
          </div>
        </section>

        <section class="section" aria-labelledby="publications-title">
          <h2 id="publications-title" class="section-title">Publications</h2>
          <p class="contribution-note">* indicates equal contribution</p>
          <div class="pubs">
            <article class="pub" id="edgar">
              <a class="pub-media edgar" href="https://kwanyun.github.io/edgar/#top" target="_blank" rel="noopener" aria-label="EDGAR project">
                <span class="pub-badge">ACM TOG 2026</span>
                <img src="/assets/edgar.gif" alt="Animated comparison of the original Gaussian avatar and the EDGAR-refined avatar" width="720" height="864" loading="lazy" decoding="async" />
              </a>
              <div class="pub-info">
                <h3 class="pub-title"><a href="https://kwanyun.github.io/edgar/#top" target="_blank" rel="noopener">EDGAR: Efficient Diffusion-Driven Gaussian Avatar Refinement via Synthetic Failure</a></h3>
                <p class="pub-authors"><a href="https://kwanyun.github.io/" target="_blank" rel="noopener">Kwan Yun</a>, <a class="me" href="https://oweixx.github.io/">MinHyeok Bang</a>, <a href="https://sj0414.github.io/colette-koo/" target="_blank" rel="noopener">Colette Suhjung Koo</a>, <a href="https://vml.kaist.ac.kr/main/people/person/1" target="_blank" rel="noopener">Junyong Noh</a></p>
                <!-- 2025 JCR Journal Impact Factor, reported by ACM in July 2026. -->
                <p class="pub-venue">ACM Transactions on Graphics (<a href="https://www.acm.org/media-center/2026/july/impact-factors-2026" target="_blank" rel="noopener" title="2025 Journal Impact Factor · ACM announcement, July 2026">IF: 13.0</a>), 2026 · Accepted</p>
                <nav class="pub-links" aria-label="EDGAR publication links">
                  <a href="https://arxiv.org/abs/2611.07909" target="_blank" rel="noopener">ARXIV</a>
                  <a href="https://kwanyun.github.io/edgar/#top" target="_blank" rel="noopener">WEBSITE</a>
                  <a href="https://github.com/kwanyun/edgar-code/" target="_blank" rel="noopener">CODE</a>
                </nav>
              </div>
            </article>
            <article class="pub">
              <a class="pub-media" href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener" aria-label="Geometry-Aware Style Transfer project">
                <span class="pub-badge">ECCV 2026</span>
                <img src="/assets/geometry.jpeg" alt="Examples of geometry-aware style transfer in 3D Gaussian Splatting" />
              </a>
              <div class="pub-info">
                <h3 class="pub-title"><a href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener">Geometry-Aware Style Transfer in 3D Gaussian Splatting</a></h3>
                <p class="pub-authors"><a class="me" href="https://oweixx.github.io/">Min Hyeok Bang</a>*, <a href="https://kjun627.github.io/" target="_blank" rel="noopener">Jun Hyeong Kim</a>*, <a href="https://pknu-vlab.github.io/" target="_blank" rel="noopener">Seung Wook Kim</a>, <a href="https://vilab.jbnu.ac.kr/" target="_blank" rel="noopener">Se Ho Lee</a></p>
                <p class="pub-venue">European Conference on Computer Vision (ECCV), 2026</p>
                <nav class="pub-links" aria-label="Publication links">
                  <a href="https://arxiv.org/abs/2606.24144" target="_blank" rel="noopener">ARXIV</a>
                  <a href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener">WEBSITE</a>
                  <a href="https://github.com/oweixx/gast" target="_blank" rel="noopener">CODE</a>
                </nav>
              </div>
            </article>
          </div>
        </section>



        <section class="section recent-posts" aria-labelledby="recent-posts-title">
          <h2 id="recent-posts-title" class="section-title">Recent Posts</h2>
          <PostList posts={posts.slice(0, 3)} compact />
          <p class="all-posts"><a href="/blog/">All posts →</a></p>
        </section>
      </main>
      <footer class="footer">© 2026 MinHyeok Bang</footer>
    </div>
  </div>
  <script>
    import { loadViewCounts } from '../scripts/view-counts';
    void loadViewCounts();
  </script>
  <Analytics />
</body>
</html>
