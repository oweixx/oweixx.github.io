---
import '../styles/blog.css';
import { getPosts, formatDate, postUrl } from '../lib/posts';
import { publications } from '../data/publications';
import Analytics from '../components/Analytics.astro';
import ViewCount from '../components/ViewCount.astro';
import SiteFonts from '../components/SiteFonts.astro';
import Citation from '../components/Citation.astro';
const posts = await getPosts();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MinHyeok Bang</title>
  <meta name="description" content="MinHyeok Bang — undergraduate researcher in 3D vision, Gaussian avatars, and generative modeling at Jeonbuk National University." />
  <link rel="canonical" href="https://oweixx.github.io/" />
  <SiteFonts />
</head>
<body class="academic-home">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="home-shell">
    <header class="profile">
      <div class="profile-copy">
        <h1>MinHyeok Bang</h1>
        <p>I am a B.S. student in Computer Science at Jeonbuk National University.</p>
        <p>I work with <a href="https://vilab.jbnu.ac.kr/">Prof. Se-Ho Lee</a> at the <a href="https://vilab.jbnu.ac.kr/">Vision Intelligence Lab</a>, JBNU, and <a href="https://vml.kaist.ac.kr/main/people/person/1">Prof. Junyong Noh</a> at the <a href="https://vml.kaist.ac.kr/">Visual Media Lab</a>, KAIST.</p>
        <p>I also write about research and things I learn on my <a href="/blog/">blog</a>.</p>
        <nav class="profile-links" aria-label="Profile links">
          <a href="https://github.com/oweixx" target="_blank" rel="noopener">GitHub</a><span aria-hidden="true">/</span>
          <a href="https://scholar.google.com/citations?user=p1X1SGAAAAAJ&hl=ko" target="_blank" rel="noopener">Scholar</a><span aria-hidden="true">/</span>
          {import.meta.env.DEV && <><a href="/write/">글쓰기</a><span aria-hidden="true">/</span></>}
          <a href="/blog/">Blog</a>
        </nav>
        <div class="site-visits" aria-label="Site visits"><ViewCount path="TOTAL" period="today" label="Today" /><ViewCount path="TOTAL" label="Total" /></div>
      </div>
      <a class="portrait" href="/assets/profile.png" aria-label="View MinHyeok Bang's profile photo"><img src="/assets/profile.png" alt="MinHyeok Bang" width="256" height="256" /></a>
    </header>
    <main id="main">
      <section aria-labelledby="research-title">
        <div class="section-intro">
          <h2 id="research-title">Research</h2>
          <p>I am interested in 3D vision and generative modeling. My research focuses on Gaussian avatars and on transferring appearance and geometry to 3D scenes.</p>
          <p class="contribution-note">* indicates equal contribution.</p>
        </div>
        <div class="publications">
          {publications.map((paper) => (
            <article class="publication" id={paper.id}>
              <a class="publication-media" href={paper.website} target="_blank" rel="noopener" aria-label={`${paper.title} project`}><img src={paper.image} alt={paper.imageAlt} loading="lazy" decoding="async" width="160" height="160" /></a>
              <div class="publication-copy">
                <h3><a href={paper.website} target="_blank" rel="noopener">{paper.title}</a></h3>
                <p class="pub-authors">{paper.authors.map((author, index) => <>{index > 0 && ', '}<a class:list={{ me: author.me }} href={author.url} target={author.me ? undefined : '_blank'} rel={author.me ? undefined : 'noopener'}>{author.name}</a>{'equal' in author && author.equal && '*'}</>)}</p>
                <p class="pub-venue"><em>{paper.venue}</em>{paper.impactFactor && <> (IF: <a href="https://www.eurekalert.org/news-releases/1134416" title="2025 Journal Impact Factor, announced by ACM in July 2026">{paper.impactFactor}</a>)</>}, {paper.year}{paper.note && <> · {paper.note}</>}</p>
                <div class="pub-links" aria-label={`${paper.title} resources`}>
                  <a href={paper.paper} target="_blank" rel="noopener">ARXIV</a>
                  <a href={paper.website} target="_blank" rel="noopener">WEBSITE</a>
                  <a href={paper.code} target="_blank" rel="noopener">CODE</a>
                  <Citation id={paper.id} bibtex={paper.bibtex} />
                </div>
                <p class="paper-summary">{paper.summary}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="blog-section" aria-labelledby="blog-title">
        <h2 id="blog-title"><a href="/blog/">Blog</a></h2>
        <p>Research notes and things I learn along the way.</p>
        <ul>{posts.slice(0, 3).map(post => <li><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time><a href={postUrl(post)}>{post.data.title}</a></li>)}</ul>
        <a class="all-posts" href="/blog/">All posts →</a>
      </section>
    </main>
    <footer>© 2026 MinHyeok Bang <span>Layout inspired by <a href="https://jonbarron.info/">Jon Barron</a>.</span></footer>
  </div>
  <script>
    import { loadViewCounts } from '../scripts/view-counts';
    void loadViewCounts();
  </script>
  <Analytics />
</body>
</html>
<style is:global>
  .academic-home { font-size: 14px; line-height: normal; color: #000; }
  .academic-home a { color: #1772d0; text-decoration: none; }
  .academic-home a:hover { color: #f09228; }
  .home-shell { width: 100%; max-width: 800px; margin: 8px auto 0; }
  .profile { display: grid; grid-template-columns: 63% 37%; align-items: center; }
  .profile-copy { padding: 20px; }
  .profile h1 { margin: 0; padding-top: 20px; font-size: 32px; font-weight: 400; text-align: center; }
  .profile p { margin: 14px 0; }
  .profile-links { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: center; }
  .profile-links span { color: #000; }
  .site-visits { display: flex; justify-content: center; gap: 18px; margin-top: 14px; font-size: 12px; color: #777; }
  .portrait { display: block; margin: 20px; }
  .portrait img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 50%; }
  .home-shell h2 { margin: 0; font-size: 22px; font-weight: 400; }
  .section-intro { padding: 16px; }
  .section-intro p { margin: 14px 0 0; }
  .section-intro .contribution-note { color: #666; font-size: 12px; }
  .publications { display: grid; gap: 10px; }
  .publication { display: grid; grid-template-columns: 192px minmax(0, 1fr); align-items: center; scroll-margin-top: 16px; }
  .publication-media { display: block; margin: 16px; }
  .publication-media img { display: block; width: 160px; height: 160px; object-fit: contain; }
  .publication-copy { padding: 8px; min-width: 0; }
  .publication h3 { margin: 0; font-size: 14px; font-weight: 700; }
  .pub-authors, .pub-venue { margin: 3px 0 0; }
  .academic-home .pub-authors a { color: #000; }
  .academic-home .pub-authors a:hover, .academic-home .pub-authors a:focus-visible { color: #1772d0; }
  .pub-authors .me { font-weight: 700; }
  .pub-links { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .academic-home .pub-links > a { display: inline-flex; align-items: center; padding: 4px 12px; border: 1px solid #262626; border-radius: 2px; color: #262626; font-size: 11px; line-height: 1.5; }
  .academic-home .pub-links > a:hover, .academic-home .pub-links > a:focus-visible { color: #fff; background: #1772d0; border-color: #1772d0; }
  .paper-summary { margin: 12px 0 0; }
  .blog-section { padding: 24px 16px; }
  .blog-section h2 a { color: #000; }
  .blog-section p { margin: 14px 0; }
  .blog-section ul { padding: 0; margin: 0 0 14px; list-style: none; display: grid; gap: 12px; }
  .blog-section li { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 12px; }
  .blog-section time { color: #666; font-size: 12px; }
  .home-shell footer { padding: 24px 16px; font-size: 12px; color: #777; display: flex; justify-content: space-between; gap: 16px; }
  @media (max-width: 560px) {
    .profile { grid-template-columns: 1fr; }
    .profile-copy { padding: 16px 20px; }
    .portrait { width: 168px; margin: 0 auto 20px; }
    .publication { grid-template-columns: 120px minmax(0, 1fr); align-items: start; }
    .publication-media { margin: 12px; }
    .publication-media img { width: 96px; height: 120px; }
    .publication-copy { padding: 12px 16px 12px 0; }
    .home-shell footer { flex-wrap: wrap; }
  }
  @media (max-width: 380px) {
    .publication { grid-template-columns: 1fr; }
    .publication-media { margin: 12px 16px 0; }
    .publication-media img { width: 160px; height: 120px; }
    .publication-copy { padding: 12px 16px; }
  }
</style>
