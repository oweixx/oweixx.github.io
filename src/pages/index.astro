---
import "../styles/blog.css";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
import Analytics from "../components/Analytics.astro";
import ViewCount from "../components/ViewCount.astro";
const posts = await getPosts();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MinHyeok Bang</title>
  <meta name="description" content="MinHyeok Bang — BS student at Jeonbuk National University, researching 3D vision and generative modeling." />
  <link rel="canonical" href="https://oweixx.github.io/" />
  <style is:global>
    body { font-family: Georgia, 'Times New Roman', serif; color: #1a1a1a; }
    a { color: #2779c4; }
    .wrap { min-height: 100vh; padding: 48px 48px 72px; }
    .container { max-width: 1240px; margin: 0 auto; }
    .name { margin: 0 0 32px; font-size: 36px; line-height: 1.2; font-weight: 700; }
    .profile { display: flex; align-items: center; gap: 40px; }
    .photo { width: 184px; height: 184px; flex: 0 0 184px; }
    .photo img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }
    .profile-info { min-width: 0; }
    .position { margin: 0 0 6px; font-size: 22px; font-weight: 700; line-height: 1.4; }
    .department { margin: 0 0 18px; font-size: 19px; line-height: 1.5; }
    .links { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: 18px; line-height: 1.5; }
    .links a::before { content: '['; }
    .links a::after { content: ']'; }
    .site-visits { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; font-family: Arial, sans-serif; font-size: 12px; color: #737373; }
    .section { margin-top: 44px; }
    .section-title { margin: 0 0 16px; padding-bottom: 7px; border-bottom: 1px solid #ccc; font-size: 27px; font-weight: 700; line-height: 1.3; }
    .about p { margin: 0 0 14px; font-size: 19px; line-height: 1.75; }
    .about p:last-child { margin-bottom: 0; }
    .contribution-note { margin: 0 0 26px; font-size: 17px; line-height: 1.5; }
    .pubs { display: grid; gap: 36px; }
    .pub { display: grid; grid-template-columns: minmax(0, 44%) minmax(0, 1fr); gap: 32px; align-items: start; }
    .pub-media { display: block; position: relative; overflow: hidden; box-shadow: 0 2px 9px rgb(0 0 0 / 15%); }
    .pub-media img { width: 100%; height: auto; display: block; }
    .pub-badge { position: absolute; top: 8px; left: 8px; padding: 4px 9px; border-radius: 3px; background: #2779c4; color: #fff; font-family: Arial, sans-serif; font-size: 14px; font-weight: 700; line-height: 1.3; }
    .pub-title { margin: 0 0 10px; font-size: 26px; line-height: 1.35; font-weight: 700; }
    .pub-title a { color: inherit; }
    .pub-title a:hover { color: #2779c4; }
    .pub-authors { margin: 0 0 10px; font-size: 21px; line-height: 1.5; }
    .pub-authors .me { font-weight: 700; }
    .pub-venue { margin: 0 0 14px; font-size: 19px; line-height: 1.5; font-style: italic; }
    .pub-links { display: flex; flex-wrap: wrap; gap: 6px 12px; font-size: 21px; line-height: 1.5; }
    .news { display: grid; gap: 12px; }
    .news-row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 20px; font-size: 17px; line-height: 1.6; }
    .news-date { font-weight: 700; }
    .recent-posts .post-list > li:first-child { border-top: 0; }
    .recent-posts .post-list > li { padding: 14px 0 20px; }
    .recent-posts .post-list h2 { font-size: 20px; }
    .all-posts { margin: 16px 0 0; font-size: 17px; }
    .footer { margin-top: 60px; padding-top: 22px; border-top: 1px solid #ddd; color: #737373; font-size: 14px; }
    @media (max-width: 760px) {
      .wrap { padding: 32px 22px 48px; }
      .name { font-size: 32px; margin-bottom: 24px; }
      .profile { gap: 22px; }
      .photo { width: 128px; height: 128px; flex-basis: 128px; }
      .position { font-size: 19px; }
      .department { font-size: 16px; margin-bottom: 12px; }
      .links { font-size: 16px; gap: 6px 10px; }
      .section { margin-top: 36px; }
      .section-title { font-size: 25px; }
      .about p { font-size: 17px; }
      .pub { grid-template-columns: minmax(0, 1fr); gap: 22px; }
      .pub-title { font-size: 23px; }
      .pub-authors, .pub-links { font-size: 18px; }
      .pub-venue { font-size: 17px; }
      .news-row { grid-template-columns: 90px minmax(0, 1fr); gap: 14px; font-size: 16px; }
    }
    @media (max-width: 420px) {
      .profile { flex-direction: column; align-items: flex-start; gap: 20px; }
      .photo { width: 144px; height: 144px; flex-basis: auto; }
      .news-row { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    }
  </style>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="wrap">
    <div class="container">
      <header>
        <h1 class="name">MinHyeok Bang</h1>
        <div class="profile">
          <div class="photo"><img src="/assets/profile.png" alt="MinHyeok Bang" width="184" height="184" /></div>
          <div class="profile-info">
            <p class="position">BS student @ JBNU</p>
            <p class="department">Computer Science · Jeonbuk National University</p>
            <nav class="links" aria-label="Profile links">
              <a href="https://scholar.google.com/citations?user=p1X1SGAAAAAJ&hl=ko" target="_blank" rel="noopener">Google Scholar</a>
              <a href="https://github.com/oweixx" target="_blank" rel="noopener">GitHub</a>
              {import.meta.env.DEV && <a href="/write/">글쓰기</a>}
              <a href="/blog/">Blog</a>
            </nav>
            <div class="site-visits" aria-label="Site visits">
              <ViewCount path="TOTAL" period="today" label="Today" />
              <ViewCount path="TOTAL" label="Total" />
            </div>
          </div>
        </div>
      </header>

      <main id="main">
        <section class="section about" aria-labelledby="about-title">
          <h2 id="about-title" class="section-title">About Me</h2>
          <p>I am an undergraduate student at Jeonbuk National University, majoring in Computer Science.</p>
          <p>My research interests lie in 3D vision and generative modeling, including Gaussian Splatting, avatars, and style transfer.</p>
          <p>I work with <a href="https://jbnu-vilab.github.io/people/">Prof. Se-Ho Lee</a> at the <a href="https://jbnu-vilab.github.io/">Vision Intelligence Lab</a> @ JBNU and <a href="https://vml.kaist.ac.kr/main/people/person/1">Prof. Junyong Noh</a> at the <a href="https://vml.kaist.ac.kr/">Visual Media Lab</a> @ KAIST.</p>
          <p>I write about my research and learning experiences on my <a href="/blog/">blog</a>.</p>
        </section>

        <section class="section" aria-labelledby="publications-title">
          <h2 id="publications-title" class="section-title">Publications</h2>
          <p class="contribution-note">* indicates equal contribution</p>
          <div class="pubs">
            <article class="pub">
              <a class="pub-media" href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener" aria-label="Geometry-Aware Style Transfer project">
                <span class="pub-badge">ECCV 2026</span>
                <img src="/assets/geometry.jpeg" alt="Examples of geometry-aware style transfer in 3D Gaussian Splatting" />
              </a>
              <div class="pub-info">
                <h3 class="pub-title"><a href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener">Geometry-Aware Style Transfer in 3D Gaussian Splatting</a></h3>
                <p class="pub-authors"><span class="me">Min Hyeok Bang</span>*, Jun Hyeong Kim*, Seung Wook Kim, Se Ho Lee</p>
                <p class="pub-venue">European Conference on Computer Vision (ECCV), 2026</p>
                <nav class="pub-links" aria-label="Publication links">
                  <a href="https://arxiv.org/abs/2606.24144" target="_blank" rel="noopener">[paper]</a>
                  <span aria-hidden="true">·</span>
                  <a href="https://github.com/oweixx/gast" target="_blank" rel="noopener">[code]</a>
                  <span aria-hidden="true">·</span>
                  <a href="https://kjun627.github.io/gast-web/" target="_blank" rel="noopener">[project]</a>
                </nav>
              </div>
            </article>
          </div>
        </section>

        <section class="section" aria-labelledby="news-title">
          <h2 id="news-title" class="section-title">News</h2>
          <div class="news">
            <div class="news-row">
              <div class="news-date">Jun, 2026</div>
              <div><a href="https://kjun627.github.io/gast-web/">Geometry-Aware Style Transfer</a> has been accepted to <strong>ECCV 2026</strong>.</div>
            </div>
            <div class="news-row">
              <div class="news-date">Dec, 2025</div>
              <div>Joined the <a href="https://vml.kaist.ac.kr/">Visual Media Lab</a> @ KAIST as an undergraduate researcher.</div>
            </div>
            <div class="news-row">
              <div class="news-date">Apr, 2025</div>
              <div>Joined the <a href="https://jbnu-vilab.github.io/">Vision Intelligence Lab</a> @ JBNU as an undergraduate researcher.</div>
            </div>
          </div>
        </section>

        <section class="section recent-posts" aria-labelledby="recent-posts-title">
          <h2 id="recent-posts-title" class="section-title">Recent Posts</h2>
          <PostList posts={posts.slice(0, 3)} compact />
          <p class="all-posts"><a href="/blog/">All posts →</a></p>
        </section>
      </main>
      <footer class="footer">© 2026 MinHyeok Bang</footer>
    </div>
  </div>
  <script>
    import { loadViewCounts } from '../scripts/view-counts';
    void loadViewCounts();
  </script>
  <Analytics />
</body>
</html>
